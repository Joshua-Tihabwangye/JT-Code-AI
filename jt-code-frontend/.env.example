# Clerk frontend key. Never put CLERK_SECRET_KEY in the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Django API. Use /api when Vite proxy or same-origin reverse proxy is enabled.
VITE_API_BASE_URL=/api/v1

# Sentry browser DSN. Leave blank to disable telemetry locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Display metadata
VITE_APP_NAME=JT-Code
VITE_APP_VERSION=0.1.0
