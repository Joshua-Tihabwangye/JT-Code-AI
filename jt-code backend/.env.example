DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Supabase PostgreSQL connection. Use a direct/session-pooler URI for a long-running Django service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jtcode
DATABASE_CONN_MAX_AGE=60

# Clerk
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_me

# Cloudinary
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
CLOUDINARY_UPLOAD_FOLDER=jt-code/development
CLOUDINARY_MAX_UPLOAD_BYTES=26214400

# Redis cache + Celery transport
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Kafka event bus
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=jt-code-api
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_TOPIC_PREFIX=jt-code.dev

# Sentry is the primary application monitoring platform.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_RELEASE=jt-code-api@0.1.0

# n8n error workflows may post sanitized failures to the relay endpoint.
N8N_SENTRY_RELAY_SECRET=replace_me

# Boilerplate-only provider adapter. "echo" is for local smoke tests; use "disabled" outside local dev.
AI_PROVIDER=echo
